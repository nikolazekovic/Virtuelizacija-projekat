library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity washing_machine is
    port (
        clk   : in  std_logic;
        rst   : in  std_logic;
        door_closed : in std_logic;

        motor  : out std_logic;
        valve  : out std_logic;
        pump   : out std_logic
    );
end washing_machine;

architecture rtl of washing_machine is

    type state_type is (
        IDLE,
        FILL_WATER,
        WASH,
        RINSE,
        SPIN,
        DRAIN,
        END_PROGRAM
    );

    signal state, next_state : state_type;
    signal timer : integer range 0 to 10;

begin

    ------------------------------------------------------------------
    -- Sekvencijalni deo (FSM + brojač vremena)
    ------------------------------------------------------------------
    process(clk, rst)
    begin
        if rst = '1' then
            state <= IDLE;
            timer <= 0;
        elsif rising_edge(clk) then
            state <= next_state;

            if state /= next_state then
                timer <= 0;
            else
                timer <= timer + 1;
            end if;
        end if;
    end process;

    ------------------------------------------------------------------
    -- Kombinacioni deo (prelazi stanja)
    ------------------------------------------------------------------
    process(state, timer, door_closed)
    begin
        next_state <= state;

        case state is

            when IDLE =>
                if door_closed = '1' then
                    next_state <= FILL_WATER;
                end if;

            when FILL_WATER =>
                if timer = 3 then
                    next_state <= WASH;
                end if;

            when WASH =>
                if timer = 5 then
                    next_state <= RINSE;
                end if;

            when RINSE =>
                if timer = 3 then
                    next_state <= SPIN;
                end if;

            when SPIN =>
                if timer = 4 then
                    next_state <= DRAIN;
                end if;

            when DRAIN =>
                if timer = 2 then
                    next_state <= END_PROGRAM;
                end if;

            when END_PROGRAM =>
                next_state <= END_PROGRAM;

        end case;
    end process;

    ------------------------------------------------------------------
    -- Izlazi (Moore automat)
    ------------------------------------------------------------------
    process(state)
    begin
        motor <= '0';
        valve <= '0';
        pump  <= '0';

        case state is
            when FILL_WATER =>
                valve <= '1';

            when WASH | RINSE | SPIN =>
                motor <= '1';

            when DRAIN =>
                pump <= '1';

            when others =>
                null;
        end case;
    end process;

end rtl;
