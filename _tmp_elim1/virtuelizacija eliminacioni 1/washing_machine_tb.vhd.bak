library ieee;
use ieee.std_logic_1164.all;

entity washing_machine_tb is
end washing_machine_tb;

architecture tb of washing_machine_tb is

    signal clk   : std_logic := '0';
    signal rst   : std_logic := '0';
    signal door_closed : std_logic := '0';

    signal motor : std_logic;
    signal valve : std_logic;
    signal pump  : std_logic;

    constant clk_period : time := 10 ns;

begin

    uut: entity work.washing_machine
        port map (
            clk => clk,
            rst => rst,
            door_closed => door_closed,
            motor => motor,
            valve => valve,
            pump => pump
        );

    ------------------------------------------------------------------
    -- Generator takta
    ------------------------------------------------------------------
    clk_process : process
    begin
        while true loop
            clk <= '0';
            wait for clk_period / 2;
            clk <= '1';
            wait for clk_period / 2;
        end loop;
    end process;

    ------------------------------------------------------------------
    -- Test scenario
    ------------------------------------------------------------------
    stim_proc : process
    begin
        -- Reset
        rst <= '1';
        wait for 20 ns;
        rst <= '0';

        -- Vrata zatvorena → start programa
        door_closed <= '1';

        -- Simulacija dovoljno dugo da prođe ceo ciklus
        wait for 500 ns;

        wait;
    end process;

end tb;
